{
  "name": "austria-population-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Interactive dashboard of Austrian population by region, 2002-2026",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --port 4174",
    "typecheck": "vue-tsc --noEmit",
    "data": "python pipeline/update.py",
    "data:validate": "python pipeline/validate.py",
    "data:geo": "python pipeline/build_geo.py",
    "test:smoke": "node tools/smoke.mjs",
    "test:inspect": "node tools/inspect.mjs"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "maplibre-gl": "^6.4.0",
    "pinia": "^4.0.3",
    "plotly.js-basic-dist-min": "^3.7.0",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0",
    "vuetify": "^4.1.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/plotly.js-basic-dist-min": "^2.12.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "sass-embedded": "^1.102.0",
    "typescript": "~5.9",
    "vite": "^8.2.1",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-tsc": "^3.3.10"
  }
}
